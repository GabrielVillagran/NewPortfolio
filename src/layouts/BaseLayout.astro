---
import '../styles/global.css';
import { navigation } from '../data/site';
interface Props {
  title: string;
  description: string;
  section?: string;
}
const { title, description, section = 'PERSONAL SYSTEM' } = Astro.props;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090d10" />
    <meta name="description" content={description} />
    <title>{title === "Home" ? "Gabriel Villagrán | Software Engineer" : `${title} | Gabriel Villagrán`}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title === "Home" ? "Gabriel Villagrán | Software Engineer" : `${title} | Gabriel Villagrán`} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-frame" data-site-shell>
      <div class="ambient-backdrop" aria-hidden="true"><div class="ambient-grid"></div><div class="ambient-beam"></div><div class="ambient-vignette"></div></div>
      <header class="topbar">
        <a class="logo" href="/" aria-label="Gabriel Villagrán home"><span class="logo-mark" aria-hidden="true">GV<span class="logo-slash">/</span></span><span class="logo-caption">GABRIEL <b>VILLAGRÁN</b><small>SOFTWARE ENGINEER</small></span></a>
        <nav class="main-nav" aria-label="Main navigation">
          {navigation.map((item, index) => <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}><span class="nav-index">0{index + 1}</span>{item.label}</a>)}
        </nav>
        <span class="header-status"><span class="status-dot" /> SYSTEM ONLINE</span>
      </header>
      <div class="system-strip"><span>GV // PERSONAL DEVELOPMENT ARCHIVE</span><span>{section}</span><span class="strip-end">EST. 1998 &nbsp; • &nbsp; BUILD 001</span></div>
      <main id="content"><slot /></main>
      <aside class="analytics-consent" data-analytics-consent hidden aria-labelledby="analytics-consent-title">
        <div>
          <strong id="analytics-consent-title">OPTIONAL ANALYTICS</strong>
          <p>May I use Google Analytics to understand visits, article views, and résumé downloads? Analytics is optional, and you can change your choice later.</p>
        </div>
        <div class="analytics-consent-actions">
          <button type="button" data-analytics-reject>DECLINE</button>
          <button type="button" data-analytics-accept>ACCEPT</button>
        </div>
      </aside>
      <footer class="footer"><div><span class="eyebrow">END OF TRANSMISSION / 001</span><p>Gabriel Villagrán</p><small>Software engineering, writing, and building.</small></div><div class="footer-links"><a href="https://github.com/GabrielVillagran" target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a href="https://open.spotify.com/user/12137688570?si=60bcae74be154a7c" target="_blank" rel="noopener noreferrer">SPOTIFY ↗</a><a href="#content">BACK TO TOP ↑</a><button type="button" class="privacy-settings" data-analytics-settings>ANALYTICS SETTINGS</button></div></footer>
    </div>
    <script>
      const measurementId = 'G-QD08W85PQZ';
      const consentKey = 'gv-analytics-consent-v1';
      const consentPanel = document.querySelector<HTMLElement>('[data-analytics-consent]');
      const acceptButton = document.querySelector<HTMLButtonElement>('[data-analytics-accept]');
      const rejectButton = document.querySelector<HTMLButtonElement>('[data-analytics-reject]');

      const enableAnalytics = () => {
        if (document.querySelector('script[data-ga4]')) return;
        const win = window as typeof window & { dataLayer?: unknown[][]; gtag?: (...args: unknown[]) => void };
        win.dataLayer = win.dataLayer || [];
        win.gtag = win.gtag || ((...args: unknown[]) => { win.dataLayer!.push(args); });
        win.gtag('js', new Date());
        win.gtag('config', measurementId, { anonymize_ip: true });
        const script = document.createElement('script');
        script.async = true;
        script.dataset.ga4 = 'true';
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
        document.head.appendChild(script);
      };

      let analyticsChoice: string | null = null;
      try { analyticsChoice = localStorage.getItem(consentKey); } catch { /* Storage unavailable */ }
      if (analyticsChoice === 'accepted') enableAnalytics();
      else if (analyticsChoice !== 'declined' && consentPanel) consentPanel.hidden = false;
      const saveConsent = (choice: 'accepted' | 'declined') => {
        try { localStorage.setItem(consentKey, choice); } catch { /* Storage unavailable */ }
        if (consentPanel) consentPanel.hidden = true;
        if (choice === 'accepted') enableAnalytics();
        else if (analyticsChoice === 'accepted') window.location.reload();
        analyticsChoice = choice;
      };
      acceptButton?.addEventListener('click', () => saveConsent('accepted'));
      rejectButton?.addEventListener('click', () => saveConsent('declined'));
      document.querySelector<HTMLButtonElement>('[data-analytics-settings]')?.addEventListener('click', () => { if (consentPanel) consentPanel.hidden = false; });

      const shell = document.querySelector<HTMLElement>('[data-site-shell]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      if (shell && finePointer.matches && !reducedMotion.matches) {
        let queued = false;
        let pointerX = window.innerWidth * 0.75;
        let pointerY = window.innerHeight * 0.3;
        const update = () => {
          shell.style.setProperty('--ambient-x', `${pointerX}px`);
          shell.style.setProperty('--ambient-y', `${pointerY}px`);
          queued = false;
        };
        window.addEventListener('pointermove', event => {
          pointerX = event.clientX;
          pointerY = event.clientY;
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>
