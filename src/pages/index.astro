---
import BaseLayout from '../layouts/BaseLayout.astro';
import { roles, projects, stack } from '../data/site';
---
<BaseLayout title="Home" description="Gabriel Villagrán's personal developer portfolio: mobile engineering, backend systems, games, and industrial monitoring." section="COMMAND / HOME">
  <section class="hero">
    <div class="hero-content">
      <span class="eyebrow"><span class="inline-square" /> PROFILE // 001 — ENGINEERING</span>
      <h1>GABRIEL<br /><span>VILLAGRÁN</span></h1>
      <p class="hero-role">SOFTWARE ENGINEER <span class="separator">//</span> BUILDER <span class="separator">//</span> ALWAYS LEARNING</p>
      <p class="hero-description">I’m a software engineer with experience building mobile applications, backend systems, and alarm and monitoring solutions for major U.S. transportation hubs, including LaGuardia and SFO airports.</p>
      <p class="hero-description secondary">I have a passion for continuous learning. In my free time, I'm learning to build video games using Three.js and develop small apps.</p>
      <div class="hero-actions"><a class="button button-primary" href="/work/">EXPLORE EXPERIENCE <span>↗</span></a><a class="button button-outline" href="/projects/">VIEW PROJECTS <span>↗</span></a></div>
    </div>
    <div class="hero-photo">
      <img src="/images/gabriel-stadium.webp" alt="Gabriel at a football stadium in Atlanta" loading="eager" width="960" height="1280" onerror="this.onerror=null;this.src='https://raw.githubusercontent.com/GabrielVillagran/Gabriel-Portfolio/master/public/images/gabriel-profile.webp';" />
      <div class="hero-photo-overlay"><span>ATLANTA // PERSONAL ARCHIVE</span><span>WORLD CUP EXPERIENCE</span></div>
    </div>
    <div class="hero-bottom"><span>SCROLL TO EXPLORE ↓</span><span>LOCAL BUILD / NO PUBLIC DEPLOYMENT</span></div>
  </section>
  <section class="section-block" id="experience"><div class="section-heading"><div><span class="eyebrow">01 / EXPERIENCE LOG</span><h2>WORKING <span>EXPERIENCE.</span></h2><p>Places I’ve had the pleasure of building great things with.</p></div><a class="small-link" href="/work/">ALL EXPERIENCE ↗</a></div><div class="role-grid">{roles.map((role, i) => <article class="panel role-card"><span class="card-num">0{i + 1} / DEPLOYMENT HISTORY</span><h3>{role.company}</h3><span class="role-caption">{role.role}</span><span class="role-location">{role.location}</span><p>{role.description}</p><div class="tag-list">{role.tags.map(tag => <span>{tag}</span>)}</div><div class="card-foot">{role.period}<span>↗</span></div></article>)}</div></section>
  <section class="section-block"><div class="section-heading"><div><span class="eyebrow">02 / ACTIVE BUILDS</span><h2>THE <span>WORKSHOP.</span></h2><p>Small projects I make to try new ideas, learn new tools, and have some fun along the way.</p></div><a class="small-link" href="/projects/">ALL PROJECTS ↗</a></div><div class="project-grid">{projects.map(project => <article class="project-card"><div class="project-art"><div class="project-art-grid"></div><span class="project-art-index">PROJECT // {project.id}</span><span class="project-symbol">{project.id === '01' ? '⌖' : '◇'}</span><span class="project-art-corner">[ EXPERIMENTAL ]</span></div><div class="project-information"><span class="eyebrow">{project.category} / {project.status}</span><h3>{project.name}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map(tag => <span>{tag}</span>)}</div></div></article>)}</div></section>
  <section class="section-block"><div class="section-heading"><div><span class="eyebrow">03 / LOADOUT</span><h2>TECH <span>STACK.</span></h2><p>Tools I’ve worked with and technologies I’m learning. Not everything here is at the same level.</p></div></div><div class="stack-grid">{stack.map((group, i) => <article class="panel stack-panel"><span class="card-num">MODULE / 0{i + 1}</span><h3>{group.name}</h3><div class="tag-list">{group.items.map(item => <span>{item}</span>)}</div></article>)}</div></section>
  <section class="bottom-cta"><span class="eyebrow">04 / PERSONAL ARCHIVE</span><h2>MORE THAN <span>CODE.</span></h2><p>Metal, video games, programming and plenty of things I'm still learning.</p><a class="button button-primary" href="/about/">A LITTLE ABOUT ME <span>↗</span></a></section>
</BaseLayout>
