---
import BaseLayout from '../layouts/BaseLayout.astro';
import { roles } from '../data/site';
---
<BaseLayout title="Work" description="Gabriel Villagrán's software engineering work experience." section="ARCHIVE / WORK">
  <header class="page-intro"><span class="eyebrow">01 / EXPERIENCE LOG</span><h1>WORKING <span>EXPERIENCE.</span></h1><p>Places I’ve had the pleasure of building great things with.</p></header>
  <div class="detail-list">{roles.map((role, i) => <article class="detail-panel"><div class="detail-left"><span class="eyebrow">ASSIGNMENT / 0{i + 1}</span><h2>{role.company}</h2><span class="role-caption">{role.role}</span><p class="period">{role.period}</p></div><div><p>{role.description}</p><div class="tag-list">{role.tags.map(tag => <span>{tag}</span>)}</div></div></article>)}</div>
</BaseLayout>
